  (text "Examen 01 - Invernadero de tomate con Raspberry Pi 5" (at 20.32 17.78 0) (effects (font (size 3 3)) (justify left bottom)) (uuid c985356f-b3fc-40e3-b345-f79ee11da75c))
  (text "Conexiones por etiqueta de red: los pines con el mismo nombre estan conectados." (at 20.32 165.1 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid 6a24d3ef-af7e-4a74-9cdb-832797b633fa))
  (text "Todos los sensores se alimentan con 3V3 (pin 1). El pin 5V0 no se usa." (at 20.32 170.18 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid 71dd5c8c-b544-4b7e-bca9-9dda5907181c))
  (text "Agua, suelo y LDR se leen como 0/1 en un GPIO (la Pi no tiene entradas analogicas)." (at 20.32 175.26 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid f5b76b70-5da3-4b72-a036-f627bebf2972))
  (text "La bomba de riego no tiene rele: el proceso de irrigacion se simula en el programa." (at 20.32 180.34 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid 2e452e75-d41b-450d-aefc-6b498acf017a))
  (text "LED RGB en violeta (R + B) = luz UV cuando hay poca luz (LDR)." (at 20.32 185.42 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid 445d7787-052d-47a0-bf3c-a12a3adbdddf))
